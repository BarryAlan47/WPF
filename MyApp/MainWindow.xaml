                <Button Style="{StaticResource topButton}"  Margin="0 0 20 0" RenderTransformOrigin="0.5,0.5" Click="CloseTheAppButton_Click">
                    <Icon:PackIconMaterial Kind="Close"/>
                </Button>
                <!--功能标题-->
                <TextBlock x:Name="NormalQRCode_Title_TextBlock" Text="通用二维码" Grid.Row="1" FontSize="32" FontWeight="SemiBold" Margin="0 20 0 0" Foreground="#121518" HorizontalAlignment="Left"/>

                <!--浏览本地目录添加Excel表格-->
                <Button x:Name="NormalQRCode_Button_AddFile" Style="{StaticResource addButton}" Click="NormalQRCode_Button_AddFile_Click" HorizontalAlignment="Right" Grid.Row="1">
                    <StackPanel Orientation="Horizontal">
                        <Icon:PackIconMaterial Kind="PlusBoxOutline" VerticalAlignment="Center" Margin="0 1 8 0" Width="15" Height="15"/>
                        <TextBlock Text="导入Excel表格..."/>
                    </StackPanel>
                </Button>

                <!--分割线-->
                <Separator Height="1" Grid.Row="3" Background="#DAE2EA" Margin="0 -1 0 3"/>

                <!--顶部标签页按钮，目前就一个按钮-->
                <StackPanel x:Name="NormalQRCode_TabButtonGroup" Grid.Row="2" Orientation="Horizontal" Margin="0 10 0 0" Width="auto">
                    <Button x:Name="NormalQRCode_TabButton_SelectedFiles" Style="{StaticResource tabButton}" Content="已导入的Excel" Width="100" HorizontalAlignment="Left" BorderBrush="#784FF2" Foreground="#784FF2" Click="NormalQRCode_TabButton_SeletedFile_Click"/>
                </StackPanel>

                <!--表格信息列表标题-->
                <TextBlock Text="表格信息" Grid.Row="4" FontSize="18" FontWeight="SemiBold" Foreground="#121518" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <!--生成按钮所属Grid-->
                <Grid Width="400" HorizontalAlignment="Right" Grid.Row="4" Height="40">
                    <!--开始批量生成太阳码-->
                    <Button x:Name="NormalQRCode_Start_Generate_Button" Style="{StaticResource addWaterMarkButton}" Click="NormalQRCode_Start_Generate_Click"  Margin="0,2,0,2" Grid.Column="1" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="Play" VerticalAlignment="Center" Margin="0 0 8 0" Width="15" Height="15"/>
                            <TextBlock Text="开始生成二维码"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!--Members Data Grid：批量生成二维码用到的excel表格-->
                <DataGrid x:Name="NormalQRCode_membersDataGrid" RowStyle="{DynamicResource DataGridRowStyle1}" ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle1}" CellStyle="{DynamicResource DataGridCellStyle1}" Style="{DynamicResource DataGridStyle1}" Visibility="Visible" EnableRowVirtualization="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" IsReadOnly="True" CanUserResize="False" Width="auto" Binding="{Binding Number}" />
                        <DataGridTemplateColumn Header="文件名" IsReadOnly="True" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="25" Height="25" CornerRadius="50" Margin="0 0 10 0" Background="{Binding BgColor}">
                                            <TextBlock Text="{Binding Character}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Margin="0 0 0 1" IsHitTestVisible="False"/>
                                        </Border>
                                        <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="文件路径" Binding="{Binding FileDir}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="文件类型" Binding="{Binding FileType}" IsReadOnly="True" Width="*"/>
                        <DataGridTemplateColumn x:Name="NormalQRCode_EditButtonPanel" Header="" IsReadOnly="True" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel x:Name="StackPanel_EditButton" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Icon:PackIconMaterial x:Name="Check_Icon" Kind="CheckBold" Style="{StaticResource gridButtonIcon}" Width="20" Height="20" Foreground="Green" Visibility="Collapsed"/>
                                        <TextBox x:Name="AddedWaterMark_TextBox" BorderThickness="0" Background="Transparent"  Text="已添加水印" TextAlignment="Center" Foreground="#FF5F5F5F" FontSize="12" FontWeight="SemiBold" IsEnabled="False" Visibility="Collapsed"/>
                                        <hc:LoadingCircle x:Name="FileLoadingCircle" HorizontalAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Center" Width="24" Height="24" Visibility="Collapsed"/>
                                        <Button x:Name="RemoveFile_Button" Margin="0 0 0 0" Style="{StaticResource gridRemoveButton}" Width="24" Height="24" Click="RemoveFileButton_Click" Visibility="Visible">
                                            <Icon:PackIconMaterial Kind="DeleteOutline" Style="{StaticResource gridButtonIcon}" />
                                        </Button>
                                        <Button x:Name="OpenFileButton" Margin="0 0 0 0" Style="{StaticResource gridOpenFileButton}" Click="OpenFileButton_Click" Visibility="Collapsed">
                                            <Icon:PackIconMaterial Kind="Folder" Style="{StaticResource gridButtonIcon}" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!--单个二维码生成配置栏-->
                <Grid x:Name="NormalQRCode_PagePath_TextBox_Grid" Grid.Row="6" Margin="0,0,200,0">
                    <TextBlock Margin="10,0,20,0"  TextAlignment="Center" VerticalAlignment="Center" Foreground="#B0B9C6" IsHitTestVisible="False" Width="100" FontSize="15"
                        Panel.ZIndex="1" Text="链接地址"
                        Visibility="{Binding Text.IsEmpty, Converter={StaticResource BoolToVis}, ElementName=NormalQRCode_PagePath_TextBox}" />
                    <TextBox x:Name="NormalQRCode_PagePath_TextBox" Text="" Style="{StaticResource searchTextbox}" Width="auto" Height="50" FontSize="20" TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                </Grid>
                <Grid x:Name="NormalQRCode_SaveName_TextBox_Grid" Grid.Row="6" Width="200" HorizontalAlignment="Right">
                    <TextBlock Margin="10,0,20,0"  TextAlignment="Center" VerticalAlignment="Center" Foreground="#B0B9C6" IsHitTestVisible="False" Width="100" FontSize="15"
                        Panel.ZIndex="1" Text="保存名称"
                        Visibility="{Binding Text.IsEmpty, Converter={StaticResource BoolToVis}, ElementName=NormalQRCode_SaveName_TextBox}" />
                    <TextBox x:Name="NormalQRCode_SaveName_TextBox" Text="" Style="{StaticResource searchTextbox}" Width="auto" Height="50" FontSize="20" TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                </Grid>
            </Grid>

            <!--生成微信太阳码的界面-->
            <Grid x:Name="WXQRCodeGrid" Grid.Column="1" Margin="30 20 20 20" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="57*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="398*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Button Style="{StaticResource topButton}"  Margin="0 0 20 0" RenderTransformOrigin="0.5,0.5" Click="CloseTheAppButton_Click">
                    <Icon:PackIconMaterial Kind="Close"/>
                </Button>
                <!--功能标题-->
                <TextBlock x:Name="WXQRCode_Title_TextBlock" Text="微信太阳码" Grid.Row="1" FontSize="32" FontWeight="SemiBold" Margin="0 20 0 0" Foreground="#121518" HorizontalAlignment="Left"/>

                <!--浏览本地目录添加Excel表格-->
                <Button x:Name="WXQRCode_Button_AddFile" Style="{StaticResource addButton}" Click="WXQRCode_Button_AddFile_Click" HorizontalAlignment="Right" Grid.Row="1">
                    <StackPanel Orientation="Horizontal">
                        <Icon:PackIconMaterial Kind="PlusBoxOutline" VerticalAlignment="Center" Margin="0 1 8 0" Width="15" Height="15"/>
                        <TextBlock Text="导入Excel表格..."/>
                    </StackPanel>
                </Button>

                <!--分割线-->
                <Separator Height="1" Grid.Row="3" Background="#DAE2EA" Margin="0 -1 0 3"/>

                <!--顶部标签页按钮，目前就一个按钮-->
                <StackPanel x:Name="WXQRCode_TabButtonGroup" Grid.Row="2" Orientation="Horizontal" Margin="0 10 0 0" Width="auto">
                    <Button x:Name="WXQRCode_TabButton_SelectedFiles" Style="{StaticResource tabButton}" Content="已导入的Excel" Width="100" HorizontalAlignment="Left" BorderBrush="#784FF2" Foreground="#784FF2" Click="WXQRCode_TabButton_SeletedFile_Click"/>
                </StackPanel>

                <!--表格信息列表标题-->
                <TextBlock Text="表格信息" Grid.Row="4" FontSize="18" FontWeight="SemiBold" Foreground="#121518" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <!--生成按钮所属Grid-->
                <Grid Width="400" HorizontalAlignment="Right" Grid.Row="4" Height="40">
                    <!--开始批量生成太阳码-->
                    <Button x:Name="WXQRCode_Button_Multiply" Style="{StaticResource addWaterMarkButton}" Click="WXQRCode_Multiply_Start_Click"  Margin="0,2,0,2" Grid.Column="1" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="Play" VerticalAlignment="Center" Margin="0 0 8 0" Width="15" Height="15"/>
                            <TextBlock Text="批量生成太阳码"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!--Members Data Grid：批量生成二维码用到的excel表格-->
                <DataGrid RowStyle="{DynamicResource DataGridRowStyle1}" ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle1}" CellStyle="{DynamicResource DataGridCellStyle1}" x:Name="WXQRCode_membersDataGrid" Style="{DynamicResource DataGridStyle1}" Visibility="Visible" EnableRowVirtualization="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" IsReadOnly="True" CanUserResize="False" Width="auto" Binding="{Binding Number}" />
                        <DataGridTemplateColumn Header="文件名" IsReadOnly="True" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="25" Height="25" CornerRadius="50" Margin="0 0 10 0" Background="{Binding BgColor}">
                                            <TextBlock Text="{Binding Character}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Margin="0 0 0 1" IsHitTestVisible="False"/>
                                        </Border>
                                        <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="文件路径" Binding="{Binding FileDir}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="文件类型" Binding="{Binding FileType}" IsReadOnly="True" Width="*"/>
                        <DataGridTemplateColumn x:Name="WXQRCode_EditButtonPanel" Header="" IsReadOnly="True" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel x:Name="StackPanel_EditButton" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Icon:PackIconMaterial x:Name="Check_Icon" Kind="CheckBold" Style="{StaticResource gridButtonIcon}" Width="20" Height="20" Foreground="Green" Visibility="Collapsed"/>
                                        <TextBox x:Name="AddedWaterMark_TextBox" BorderThickness="0" Background="Transparent"  Text="已添加水印" TextAlignment="Center" Foreground="#FF5F5F5F" FontSize="12" FontWeight="SemiBold" IsEnabled="False" Visibility="Collapsed"/>
                                        <hc:LoadingCircle x:Name="FileLoadingCircle" HorizontalAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Center" Width="24" Height="24" Visibility="Collapsed"/>
                                        <Button x:Name="RemoveFile_Button" Margin="0 0 0 0" Style="{StaticResource gridRemoveButton}" Width="24" Height="24" Click="RemoveFileButton_Click" Visibility="Visible">
                                            <Icon:PackIconMaterial Kind="DeleteOutline" Style="{StaticResource gridButtonIcon}" />
                                        </Button>
                                        <Button x:Name="OpenFileButton" Margin="0 0 0 0" Style="{StaticResource gridOpenFileButton}" Click="OpenFileButton_Click" Visibility="Collapsed">
                                            <Icon:PackIconMaterial Kind="Folder" Style="{StaticResource gridButtonIcon}" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!--单个二维码生成配置栏-->
                <CheckBox x:Name="CheckBox_IsAR" Grid.Row="6" Content="AR" IsChecked="False" Margin="0,5" HorizontalAlignment="Left" Checked="CheckBox_IsAR_Checked" Unchecked="CheckBox_IsAR_Unchecked" Foreground="#784FF2" FontWeight="Bold"/>

                <Grid x:Name="WXQRCode_ChanelName_TextBox_Grid" Grid.Row="6" Width="0" HorizontalAlignment="Left" Margin="50,0,0,0">
                    <TextBlock Margin="7,0,25,0" TextAlignment="Center"  VerticalAlignment="Center" Foreground="#B0B9C6" IsHitTestVisible="False" Width="100" FontSize="15"
                        Panel.ZIndex="1" Text="展厅名称"
                        Visibility="{Binding Text.IsEmpty, Converter={StaticResource BoolToVis}, ElementName=WXQRCode_ChanelName_TextBox}" />
                    <TextBox x:Name="WXQRCode_ChanelName_TextBox" Text="" Style="{StaticResource searchTextbox}" Width="auto" Height="50" FontSize="20" TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                </Grid>
                <Grid x:Name="WXQRCode_PagePath_TextBox_Grid" Grid.Row="6" Margin="50,0,200,0">
                    <TextBlock Margin="10,0,20,0"  TextAlignment="Center" VerticalAlignment="Center" Foreground="#B0B9C6" IsHitTestVisible="False" Width="100" FontSize="15"
                        Panel.ZIndex="1" Text="链接地址"
                        Visibility="{Binding Text.IsEmpty, Converter={StaticResource BoolToVis}, ElementName=WXQRCode_PagePath_TextBox}" />
                    <TextBox x:Name="WXQRCode_PagePath_TextBox" Text="" Style="{StaticResource searchTextbox}" Width="auto" Height="50" FontSize="20" TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                </Grid>
                <Grid x:Name="WXQRCode_SaveName_TextBox_Grid" Grid.Row="6" Width="200" HorizontalAlignment="Right">
                    <TextBlock Margin="10,0,20,0"  TextAlignment="Center" VerticalAlignment="Center" Foreground="#B0B9C6" IsHitTestVisible="False" Width="100" FontSize="15"
                        Panel.ZIndex="1" Text="保存名称"
                        Visibility="{Binding Text.IsEmpty, Converter={StaticResource BoolToVis}, ElementName=WXQRCode_SaveName_TextBox}" />
                    <TextBox x:Name="WXQRCode_SaveName_TextBox" Text="" Style="{StaticResource searchTextbox}" Width="auto" Height="50" FontSize="20" TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                </Grid>
                <StackPanel HorizontalAlignment="Stretch" Grid.Row="6" x:Name="WXQRCode_Single_Panel" Orientation="Horizontal" Margin="0,0,0,0" Width="auto" >
                    <Grid Visibility="Collapsed">
                        <Button x:Name="WXQRCode_Button_Single" Style="{StaticResource addWaterMarkButton}" Click="WXQRCode_Single_Start_Click" Margin="0,0,0,0" Grid.Column="1" HorizontalAlignment="Left" Background="#FF459ACD">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial Kind="Play" VerticalAlignment="Center" Margin="0 0 8 0" Width="15" Height="15"/>
                                <TextBlock Text="生成单个太阳码"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>

            <!--正在添加水印遮罩-->
            <Border x:Name="AddingWaterMark_Mask" BorderBrush="#FFBBBBEC"  BorderThickness="3" CornerRadius="0,30,30,0" Background="#7FCFCDE8" Visibility="Collapsed" Height="60" VerticalAlignment="Bottom" Margin="0,0,500,20" Grid.Column="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <hc:CircleProgressBar x:Name="MyCircleProgressBar" Height="40" Width="40" Margin="10 0 0 0" Value="0" ArcThickness ="5" Text="0"  FontSize="12"/>
                    <Icon:PackIconMaterial x:Name="AddingWaterMark_Icon" Kind="CheckboxMarked" Style="{StaticResource pagingButtonIcon}" Height="30" Width="30" Foreground="#FF28B30F" Visibility="Collapsed" VerticalAlignment="Center" Margin="10 2 0 0" />
                    <TextBox x:Name="AddingWaterMark_TextBox" BorderThickness="0" Background="Transparent"  Text="请稍等，正在添加水印中...(1/3)" TextAlignment="Center" Foreground="#FF5F5F5F" FontSize="28" FontWeight="SemiBold"/>
                </StackPanel>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Page.Loaded">
                        <BeginStoryboard>
                            <Storyboard x:Name="Storyboard">
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
            <!--展开或者收起侧边菜单栏-->
            <Button x:Name="OpenOrCLoseMenuButton" Style="{StaticResource LeftButton}" HorizontalAlignment="Left" Width="24" Height="24" Margin="0,379,0,311" Foreground="#B0B9C6" Click="OpenOrCLoseMenuButton_Click" Grid.Column="1">
                <Icon:PackIconMaterial x:Name="OpenOrCLoseMenuButton_Icon" Kind="MenuRight" Width="24" Height="24"/>
            </Button>

        </Grid>
    </Border>
</Window>