<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:hc="https://handyorg.github.io/handycontrol" x:Class="MyApp.MainWindow"
        Height="720" Width="1080" WindowStartupLocation="CenterScreen" AllowsTransparency="True"
        Background="Transparent" WindowStyle="None">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border x:Name="BackgroundBorder" CornerRadius="30" MouseDown="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Background>
            <ImageBrush x:Name="CurrentImageBrush" ImageSource="C:\Git\WPF\MyApp\bin\Release\net8.0-windows\Images\BG1.jpg" Stretch="Fill">
            </ImageBrush>
        </Border.Background>

        <Grid x:Name="FatherGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MenuGrid_Width" Width="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--左侧菜单栏-->
            <Grid x:Name="MenuButton_Grid" FocusManager.FocusedElement="{Binding ElementName=MenuButton_AddWaterMark}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!--Menu Icon-->
                <Button Style="{StaticResource HelpButton}" HorizontalAlignment="Left" Margin="20 28 0 35" Click="HelpButton_Click">
                    <Icon:PackIconMaterial Kind="HelpCircleOutline" Width="25" Height="25" Visibility="Collapsed" />
                </Button>

                <Border Grid.Row="1" Background="#623ED0" CornerRadius="0 50 0 30">
                    <DockPanel>
                        <!--Menu Logo-->
                        <Border x:Name="P1_Image_Border" Width="80" Height="80" Padding="2" Background="White" CornerRadius="100" DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="20 -30 0 0">
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="FeaturedImage" ImageSource="/Images/p1.jpg"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Border>

                        <!--Menu Titles-->
                        <TextBlock Text="功能列表" Foreground="White" FontSize="22" FontWeight="SemiBold" DockPanel.Dock="Top" Margin="0 25 0 10" TextAlignment="Center"/>
                        <!--<TextBlock Text="________________________" Foreground="#D0BFFF" FontSize="14" FontWeight="SemiBold" DockPanel.Dock="Top" TextAlignment="Center"/>-->
                        <!--Menu Seprator-->
                        <Separator Margin="10" Background="#7E5FDC" DockPanel.Dock="Top" Height="0.8"/>
                        <!--Menu Buttons-->
                        <StackPanel x:Name="MenuButton_List" DockPanel.Dock="Top" >
                            <Button x:Name="MenuButton_AddWaterMark" Style="{StaticResource menuButton}" Width="170" Height="35" Click="MenuButton_AddWaterMark_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="Watermark" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="添加水印"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource menuButton}" Width="170" Height="35" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="ArrowSplitHorizontal" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="PDF拆分"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource menuButton}" Width="170" Height="35" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="TableMergeCells" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="PDF合并"/>
                                </StackPanel>
                            </Button>



                            <Button Style="{StaticResource menuButton}" Width="170" Height="35" Visibility="Collapsed" >
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="ArrowSplitHorizontal" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="文档拆分"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource menuButton}" Width="170" Height="35" Visibility="Visible" Click="MenuButton_PictureCropping_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="PictureInPictureBottomRight" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="图片裁切"/>
                                </StackPanel>
                            </Button>

                            <!--分割线-->
                            <Separator Margin="10" Background="#7E5FDC" DockPanel.Dock="Top" Height="0.8"/>

                            <Button x:Name="MenuButton_A2a" Style="{StaticResource menuButton}" Width="170" Height="35" Click="MenuButton_A2a_Click" >
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="FormatFont" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="大小写转换"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource menuButton}" Width="170" Height="35" Visibility="Visible" Click="MenuButton_MoneyRequest_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="LockOff" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="报账文档生成"/>
                                </StackPanel>
                            </Button>
                            <!--分割线-->
                            <Separator Margin="10" Background="#7E5FDC" DockPanel.Dock="Top" Height="0.8"/>

                            <Button x:Name="MenuButton_NormalQRCodeGenerated" Style="{StaticResource menuButton}" Width="170" Height="35" Click="MenuButton_NormalQRCodeGenerated_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="QrcodeMinus" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="通用二维码生成"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="MenuButton_WXQRCodeGenerated" Style="{StaticResource menuButton}" Width="170" Height="35" Click="MenuButton_WXQRCodeGenerated_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="QrcodePlus" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="微信二维码生成"/>
                                </StackPanel>
                            </Button>
                            <!--分割线-->
                            <Separator Margin="10" Background="#7E5FDC" DockPanel.Dock="Top" Height="0.8"/>

                            <Button x:Name="MenuButton_WXBotDeploy" Style="{StaticResource menuButton}" Width="170" Height="35" Click="MenuButton_NormalQRCodeGenerated_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Icon:PackIconMaterial Kind="Linkedin" Style="{StaticResource menuButtonIcon}"/>
                                    <TextBlock Text="团队预约自动化"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>

                        <Button Style="{StaticResource menuButton}" HorizontalAlignment="Center" VerticalAlignment="Bottom" DockPanel.Dock="Bottom" Margin="15 0 15 20" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" >
                                <!--<Icon:PackIconMaterial Kind="Logout" Style="{StaticResource menuButtonIcon}"/>-->
                                <TextBlock Text="———   Ver 1.0.0   ———"/>
                            </StackPanel>
                        </Button>

                    </DockPanel>
                </Border>

            </Grid>
            <!--暂未选择任何文件遮罩-->
            <TextBlock x:Name="Text_NoFiles" Text="暂未选择任何文件" FontSize="32" FontWeight="SemiBold" TextAlignment="Center"  Margin="30,300,0,176" Foreground="#FFBBC0C5" HorizontalAlignment="Center" VerticalAlignment="Center" Width="830" Grid.Column="1"/>

            <!--添加水印的Grid-->
            <Grid x:Name="MainGrid" Grid.Column="1" Margin="30 20 20 20" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="57*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="398*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <!--查找已经添加过水印的文件-->
                <Grid Width="600" HorizontalAlignment="Left" Margin="0,0,0,61" Grid.RowSpan="2">

                    <TextBlock Margin="20 0" VerticalAlignment="Center" Foreground="#B0B9C6" IsHitTestVisible="False"
                           Panel.ZIndex="1" Text="查找已经添加水印的文件..."
                           Visibility="{Binding ElementName=textBoxSearch, Path=Text.IsEmpty, Converter={StaticResource BoolToVis}}" />

                    <TextBox Name="textBoxSearch" Style="{StaticResource searchTextbox}"/>

                    <Icon:PackIconMaterial Kind="Magnify" Width="15" Height="15" VerticalAlignment="Center" Margin="0 0 15 0" Foreground="#B0B9C6" HorizontalAlignment="Right" />
                </Grid>

                <!--<Button Style="{StaticResource topButton}" Margin="0 0 55 0">
                    <Icon:PackIconMaterial Kind="Bell"/>
                </Button>-->
                <Button Style="{StaticResource topButton}"  Margin="0 0 20 0" RenderTransformOrigin="0.5,0.5" Click="CloseTheAppButton_Click">
                    <Icon:PackIconMaterial Kind="Close"/>
                </Button>
                <!--<TextBlock Text="Filter by" Grid.Row="4" FontSize="13" FontWeight="SemiBold" Margin="0 0 215 0" Foreground="#121518" HorizontalAlignment="Right" VerticalAlignment="Center"/>-->

                <!--Page Title-->
                <TextBlock x:Name="Title_TextBlock" Text="添加水印" Grid.Row="1" FontSize="32" FontWeight="SemiBold" Margin="0 20 0 0" Foreground="#121518" HorizontalAlignment="Left"/>

                <!--Add Button-->
                <Button x:Name="Button_AddFile" Style="{StaticResource addButton}" Click="Button_AddFile_Click">
                    <StackPanel Orientation="Horizontal">
                        <Icon:PackIconMaterial Kind="PlusBoxOutline" VerticalAlignment="Center" Margin="0 1 8 0" Width="15" Height="15"/>
                        <TextBlock Text="添加文件..."/>
                    </StackPanel>
                </Button>

                <!--Seprator-->
                <Separator Height="1" Grid.Row="3" Background="#DAE2EA" Margin="0 -1 0 3"/>

                <!--Tab buttons-->
                <StackPanel x:Name="TabButtonGroup" Grid.Row="2" Orientation="Horizontal" Margin="0 10 0 0" Width="auto">
                    <Button x:Name="TabButton_SelectedFiles" Style="{StaticResource tabButton}" Content="已选择文件列表" Width="100" HorizontalAlignment="Left" BorderBrush="#784FF2" Foreground="#784FF2" Click="TabButton_SeletedFile_Click"/>
                    <Button Style="{StaticResource tabButton}" Content="" Width="20" IsEnabled="False"/>
                    <Button x:Name="TabButton_AddedWaterMarkFiles" Style="{StaticResource tabButton}" Content="水印添加记录" Width="100" Click="TabButton_AddedWaterMarkFile_Click"/>
                </StackPanel>

                <!--Counter Title-->
                <TextBlock Text="文件信息" Grid.Row="4" FontSize="18" FontWeight="SemiBold" Foreground="#121518" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <!--Filter Textbox-->
                <Grid Width="400" HorizontalAlignment="Right" Grid.Row="4" Height="40">
                    <Grid x:Name="SerchFile_Grid" Width="400" HorizontalAlignment="Left" Visibility="Collapsed">
                        <TextBlock Margin="20 0" VerticalAlignment="Center" Foreground="#B0B9C6" IsHitTestVisible="False" Panel.ZIndex="1" Text="查找已经添加水印的文件..." Visibility="{Binding ElementName=SerchFile_TextBox, Path=Text.IsEmpty, Converter={StaticResource BoolToVis}}" />

                        <TextBox x:Name="SerchFile_TextBox" Height="36" Style="{StaticResource searchFileTextbox}"/>

                        <Icon:PackIconMaterial Kind="Magnify" Width="15" Height="15" VerticalAlignment="Center" Margin="0 0 15 0" Foreground="#B0B9C6" HorizontalAlignment="Right" />
                    </Grid>
                    <!--AddWaterMark Button-->
                    <Button x:Name="AddWaterMarkButton" Style="{StaticResource addWaterMarkButton}" Click="AddWaterMarkButton_Click"  Margin="0,2,0,2" Grid.Column="1" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="Play" VerticalAlignment="Center" Margin="0 0 8 0" Width="15" Height="15"/>
                            <TextBlock Text="开始添加水印"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!--Members Data Grid：待添加水印的文件列表-->
                <DataGrid RowStyle="{DynamicResource DataGridRowStyle1}" ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle1}" CellStyle="{DynamicResource DataGridCellStyle1}" x:Name="membersDataGrid" Style="{DynamicResource DataGridStyle1}" Visibility="Visible" EnableRowVirtualization="False">
                    <DataGrid.Columns>
                        <!--<DataGridCheckBoxColumn Header="C" CanUserResize="False" Width="auto" ElementStyle="{StaticResource CheckBoxStyle1}">
                            <DataGridCheckBoxColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource CheckBoxStyle1}"/>
                                </DataTemplate>
                            </DataGridCheckBoxColumn.HeaderTemplate>
                        </DataGridCheckBoxColumn>-->
                        <DataGridTextColumn Header="#" IsReadOnly="True" CanUserResize="False" Width="auto" Binding="{Binding Number}" />
                        <DataGridTemplateColumn Header="文件名" IsReadOnly="True" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="25" Height="25" CornerRadius="50" Margin="0 0 10 0" Background="{Binding BgColor}">
                                            <TextBlock Text="{Binding Character}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Margin="0 0 0 1" IsHitTestVisible="False"/>
                                        </Border>
                                        <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="文件路径" Binding="{Binding FileDir}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="文件类型" Binding="{Binding FileType}" IsReadOnly="True" Width="*"/>
                        <DataGridTemplateColumn x:Name="EditButtonPanel" Header="" IsReadOnly="True" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel x:Name="StackPanel_EditButton" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Icon:PackIconMaterial x:Name="Check_Icon" Kind="CheckBold" Style="{StaticResource gridButtonIcon}" Width="20" Height="20" Foreground="Green" Visibility="Collapsed"/>
                                        <TextBox x:Name="AddedWaterMark_TextBox" BorderThickness="0" Background="Transparent"  Text="已添加水印" TextAlignment="Center" Foreground="#FF5F5F5F" FontSize="12" FontWeight="SemiBold" IsEnabled="False" Visibility="Collapsed"/>
                                        <hc:LoadingCircle x:Name="FileLoadingCircle" HorizontalAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Center" Width="24" Height="24" Visibility="Collapsed"/>
                                        <Button x:Name="RemoveFile_Button" Margin="0 0 0 0" Style="{StaticResource gridRemoveButton}" Width="24" Height="24" Click="RemoveFileButton_Click" Visibility="Visible">
                                            <Icon:PackIconMaterial Kind="DeleteOutline" Style="{StaticResource gridButtonIcon}" />
                                        </Button>
                                        <Button x:Name="OpenFileButton" Margin="0 0 0 0" Style="{StaticResource gridOpenFileButton}" Click="OpenFileButton_Click" Visibility="Collapsed">
                                            <Icon:PackIconMaterial Kind="Folder" Style="{StaticResource gridButtonIcon}" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <!--Members Data Grid:已添加水印的文件列表-->
                <DataGrid x:Name="AddedWatermarkFile_Grid" RowStyle="{DynamicResource DataGridRowStyle1}" ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle1}" CellStyle="{DynamicResource DataGridCellStyle1}" Style="{DynamicResource DataGridStyle1}" Visibility="Collapsed">
                    <DataGrid.Columns>
                        <!--<DataGridCheckBoxColumn Header="C" CanUserResize="False" Width="auto" ElementStyle="{StaticResource CheckBoxStyle1}">
                            <DataGridCheckBoxColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource CheckBoxStyle1}"/>
                                </DataTemplate>
                            </DataGridCheckBoxColumn.HeaderTemplate>
                        </DataGridCheckBoxColumn>-->
                        <DataGridTextColumn Header="#" IsReadOnly="True" CanUserResize="False" Width="auto" Binding="{Binding Number}"/>
                        <DataGridTemplateColumn Header="文件名" IsReadOnly="True" Width="1.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="25" Height="25" CornerRadius="50" Margin="0 0 10 0" Background="{Binding BgColor}">
                                            <TextBlock Text="{Binding Character}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Margin="0 0 0 1"/>
                                        </Border>
                                        <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="文件路径" Binding="{Binding FileDir}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="文件类型" Binding="{Binding FileType}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="水印添加日期" Binding="{Binding AddWaterMarkDate}" IsReadOnly="True" Width="*"/>
                        <DataGridTemplateColumn  Header="" IsReadOnly="True" Width="auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="PositionFileButton" Style="{StaticResource gridCheckButton}" Visibility="Visible" Click="PositionFileButton_Click" Margin="0 0 1 0">
                                            <Icon:PackIconMaterial Kind="Folder" Style="{StaticResource gridButtonIcon}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <!--Pagingation Section-->
                <Border Grid.Row="6" HorizontalAlignment="Right" BorderBrush="#DEE4EC" BorderThickness="1" CornerRadius="5" Padding="5" Background="#ffffff" Margin="0 10 10 10">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource pagingButton}" Click="PageUpButton_Click">
                            <Icon:PackIconMaterial Kind="ChevronLeft" Style="{StaticResource pagingButtonIcon}"/>
                        </Button>
                        <Rectangle Width="1" Fill="#DEE4EC" Margin="3 7"/>

                        <Button Style="{StaticResource pagingButton}" Content="1" Background="#7950F2" Foreground="#ffffff"/>
                        <!--<Button Style="{StaticResource pagingButton}" Content="2" />
                        <Button Style="{StaticResource pagingButton}" Content="3"/>

                        <TextBlock Text="..." Foreground="#6C7682" VerticalAlignment="Center" Margin="10 0" FontSize="15"/>

                        <Button Style="{StaticResource pagingButton}" Content="7"/>
                        <Button Style="{StaticResource pagingButton}" Content="8"/>
                        <Button Style="{StaticResource pagingButton}" Content="9"/>-->

                        <Rectangle Width="1" Fill="#DEE4EC" Margin="3 7"/>
                        <Button Style="{StaticResource pagingButton}" Click="PageDownButton_Click">
                            <Icon:PackIconMaterial Kind="ChevronRight" Style="{StaticResource pagingButtonIcon}"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
            <!--大小写转化的Grid-->
            <Grid x:Name="a2A_Grid" Grid.Column="1" Margin="30 20 20 20" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="57*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="398*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Button Style="{StaticResource topButton}"  Margin="0 0 20 0" RenderTransformOrigin="0.5,0.5" Click="CloseTheAppButton_Click">
                    <Icon:PackIconMaterial Kind="Close"/>
                </Button>
                <!--功能标题-->
                <TextBlock x:Name="a2A_Title_TextBlock" Text="人民币大小写转换" Grid.Row="1" FontSize="32" FontWeight="SemiBold" Margin="0 20 0 0" Foreground="#121518" HorizontalAlignment="Left"/>
                <!--分割线-->
                <Separator Height="1" Grid.Row="3" Background="#DAE2EA" Margin="0 -1 0 3"/>

                <!--顶部标签页按钮，目前为空，不需要-->
                <StackPanel x:Name="a2A_TabButtonGroup" Grid.Row="2" Orientation="Horizontal" Margin="0 10 0 0" Width="auto" Height="45">
                </StackPanel>
                <!--转换前的文本输入框-->
                <Grid x:Name="a2A_TextBox_a_Grid" Grid.Row="4" Margin="0,0,0,0">
                    <TextBlock Margin="10,0,10,0"  TextAlignment="Center" VerticalAlignment="Center" Foreground="#B0B9C6" IsHitTestVisible="False" Width="auto" FontSize="16"
                        Panel.ZIndex="1" Text="请输入待转换的金额文本..."
                        Visibility="{Binding Text.IsEmpty, Converter={StaticResource BoolToVis}, ElementName=_a2A_TextBox_a}" />
                    <TextBox x:Name="_a2A_TextBox_a" TextChanged="a2A_TextBox_a_TextChanged" Text="" Style="{StaticResource searchTextbox}" Width="auto" Height="50" FontSize="18" TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,0,0" FontWeight="Bold"/>
                </Grid>

                <Grid x:Name="a2A_Image1_Grid" Grid.Row="5" Margin="5" HorizontalAlignment="Center">
                    <!-- 水平布局 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- 第一张图片 -->
                        <Image x:Name="Image_LilyOfTheValley" Source="C:\Git\WPF\MyApp\bin\Release\net8.0-windows\Images\a2A2.jpg" Stretch="Uniform" Margin="0,0,3,0" Width="0"/>
                        <!-- 第二张图片 -->
                        <Image x:Name="Image_MorningGlory" Source="C:\Git\WPF\MyApp\bin\Release\net8.0-windows\Images\a2A1.jpg" Stretch="Uniform" Margin="0,0,3,0"/>
                        <!-- 第三张图片 -->
                        <Image Source="C:\Git\WPF\MyApp\bin\Release\net8.0-windows\Images\a2A3.png" Stretch="Uniform" Margin="3,0,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="a2A_TextBox_A_Grid" Grid.Row="6" Margin="0,0,160,0">
                    <TextBlock Margin="10,0,20,0"  TextAlignment="Center" VerticalAlignment="Center" Foreground="#B0B9C6" IsHitTestVisible="False" Width="auto" FontSize="16" 
                        Panel.ZIndex="1" Text="暂无文本转换..."
                        Visibility="{Binding Text.IsEmpty, Converter={StaticResource BoolToVis}, ElementName=_a2A_TextBox_A}" />
                    <TextBox x:Name="_a2A_TextBox_A" Text="" Style="{StaticResource searchTextbox}" Width="auto" Height="50"  IsReadOnly="True" FontSize="18" TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                </Grid>
                <!--用以展现大小写转换时动效的icon-->
                <Icon:PackIconMaterial x:Name="_a2A_Icon" Kind="CapsLock" Margin="12,0,0,0" Style="{StaticResource pagingButtonIcon}" Height="32" Width="32" Grid.Row="6" Foreground="#FFA5A5A5" Visibility="Visible" HorizontalAlignment="Left"/>
                <!--生成按钮所属Grid-->
                <Grid Width="160" HorizontalAlignment="Right" Grid.Row="6" Height="40">
                    <!--复制转换后的大写金额-->
                    <Button x:Name="a2A_Copy_Button" Style="{StaticResource addWaterMarkButton}" Click="Copy_A_Value_Button_Click"  Margin="0,2,0,2" Grid.Column="1" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="ContentCopy" VerticalAlignment="Center" Margin="0 0 8 0" Width="15" Height="15"/>
                            <TextBlock Text="Copy"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
            <!--拆分PDF文件的界面-->
            <Grid x:Name="PDFSplitGrid" Grid.Column="1" Margin="30 20 20 20" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="57*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="398*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <!--Top Buttons-->
                <Button Style="{StaticResource topButton}"  Margin="0 0 20 0" RenderTransformOrigin="0.5,0.5" Click="CloseTheAppButton_Click">
                    <Icon:PackIconMaterial Kind="Close"/>
                </Button>

                <!--Page Title-->
                <TextBlock x:Name="PDFSplitGrid_Title_TextBlock" Text="拆分PDF文件" Grid.Row="1" FontSize="32" FontWeight="SemiBold" Margin="0 20 0 0" Foreground="#121518" HorizontalAlignment="Left"/>

                <!--Seprator-->
                <Separator Height="1" Grid.Row="3" Background="#DAE2EA" Margin="0 -1 0 3"/>

                <!--Tab buttons-->
                <StackPanel x:Name="PDFSplitGrid_TabButtonGroup" Grid.Row="2" Orientation="Horizontal" Margin="0 10 0 0" Width="auto">
                    <Button x:Name="PDFSplitGrid_TabButton_SplitByPage" Style="{StaticResource tabButton}" Content="逐页拆分" Width="100" HorizontalAlignment="Left" BorderBrush="#784FF2" Foreground="#784FF2" Click="TabButton_SeletedFile_Click"/>
                    <Button Style="{StaticResource tabButton}" Content="" Width="20" IsEnabled="False"/>
                    <Button x:Name="PDFSplitGrid_TabButton_SplitByUser" Style="{StaticResource tabButton}" Content="自定义拆分" Width="100" Click="TabButton_AddedWaterMarkFile_Click"/>
                </StackPanel>

                <!--Counter Title-->
                <TextBlock Text="文件信息" Grid.Row="4" FontSize="18" FontWeight="SemiBold" Foreground="#121518" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <!--Filter Textbox-->
                <Grid Width="400" HorizontalAlignment="Right" Grid.Row="4" Height="40">
                    <!--AddWaterMark Button-->
                    <Button x:Name="StartSplit_Button" Style="{StaticResource addWaterMarkButton}" Click="AddWaterMarkButton_Click"  Margin="0,2,0,2" Grid.Column="1" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconMaterial Kind="Play" VerticalAlignment="Center" Margin="0 0 8 0" Width="15" Height="15"/>
                            <TextBlock Text="开始拆分PDF"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!--Members Data Grid：待拆分的PDF文件列表-->
                <DataGrid RowStyle="{DynamicResource DataGridRowStyle1}" ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle1}" CellStyle="{DynamicResource DataGridCellStyle1}" Style="{DynamicResource DataGridStyle1}" Visibility="Visible" EnableRowVirtualization="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" IsReadOnly="True" CanUserResize="False" Width="auto" Binding="{Binding Number}" />
